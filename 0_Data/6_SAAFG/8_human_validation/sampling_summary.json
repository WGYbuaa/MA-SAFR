      "gpt-5.2-2025-12-11": 20,
      "deepseek-v3.2": 20
    },
    "method": {
      "MA-EvoGraphRAG": 10,
      "MA-NoRAG": 9,
      "MA-EvoGraphRAG w/o RSSG": 12,
      "MA-EvoGraphRAG with RSSG": 12,
      "MA-VanillaRAG": 8,
      "SA-NoRAG": 9
